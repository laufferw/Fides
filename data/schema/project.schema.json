{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laufferw/Fides/data/schema/project.schema.json",
  "title": "Fides projects file",
  "description": "data/projects.json. Every record carries its sources. A record is either real (every source has a URL and a retrieval date) or demo (fictional, flagged demo: true).",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "notice": { "type": "string", "description": "Plain-language note shown with the data set." },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "description": "A real, checkable source.",
      "type": "object",
      "required": ["title", "url", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "retrieved": { "$ref": "#/$defs/date", "description": "Date we last read the source (YYYY-MM-DD)." },
        "note": { "type": "string" }
      }
    },
    "demoSource": {
      "description": "Placeholder used only by fictional demo records.",
      "type": "object",
      "required": ["title", "demo"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "demo": { "const": true }
      }
    },
    "commitment": {
      "type": "object",
      "required": ["text", "status", "date", "source"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "The public promise, quoted or closely paraphrased." },
        "status": { "enum": ["kept", "broken", "in_progress", "not_yet_due"] },
        "date": { "$ref": "#/$defs/date", "description": "Date the commitment was made." },
        "source": { "anyOf": [{ "$ref": "#/$defs/source" }, { "$ref": "#/$defs/demoSource" }] }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id", "name", "operator", "county", "county_fips", "state", "lat", "lon", "status",
        "capacity_mw", "water_source", "cooling", "water_use", "clean_power_pct",
        "heat_reuse", "commitments", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "demo": { "type": "boolean", "description": "true = fictional record for demonstration only." },
        "name": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "county": { "type": "string", "minLength": 1 },
        "county_fips": { "type": "string", "pattern": "^\\d{5}$", "description": "5-digit county FIPS code; links the project to county data such as drought." },
        "state": { "enum": ["AZ", "CA", "CO", "NM", "NV", "UT", "WY"] },
        "lat": { "type": "number", "minimum": 31, "maximum": 46 },
        "lon": { "type": "number", "minimum": -125, "maximum": -102 },
        "status": { "enum": ["proposed", "approved", "under_construction", "operating", "cancelled"] },
        "capacity_mw": { "type": ["number", "null"], "minimum": 0, "description": "IT or grid capacity in megawatts; null if not disclosed." },
        "water_source": { "enum": ["none", "reclaimed", "non_potable", "municipal_potable", "surface", "groundwater", "undisclosed"] },
        "cooling": { "enum": ["closed_loop", "air", "hybrid", "evaporative", "undisclosed"] },
        "water_use": {
          "type": "object",
          "required": ["projected_mgy", "actual_mgy"],
          "additionalProperties": false,
          "properties": {
            "projected_mgy": { "type": ["number", "null"], "minimum": 0, "description": "Projected use, million gallons per year." },
            "actual_mgy": { "type": ["number", "null"], "minimum": 0, "description": "Reported actual use, million gallons per year." },
            "actual_year": { "type": ["integer", "null"] }
          }
        },
        "clean_power_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Share of electricity from clean sources that the operator has documented; null if not disclosed." },
        "heat_reuse": { "enum": ["operating", "planned", "none"] },
        "commitments": { "type": "array", "items": { "$ref": "#/$defs/commitment" } },
        "sources": { "type": "array", "minItems": 1 },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "demo": { "const": true } }, "required": ["demo"] },
      "then": {
        "properties": { "sources": { "items": { "anyOf": [{ "$ref": "#/$defs/source" }, { "$ref": "#/$defs/demoSource" }] } } }
      },
      "else": {
        "properties": {
          "sources": { "items": { "$ref": "#/$defs/source" } },
          "commitments": { "items": { "properties": { "source": { "$ref": "#/$defs/source" } } } }
        }
      }
    }
  }
}
