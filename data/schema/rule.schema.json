{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laufferw/Fides/data/schema/rule.schema.json",
  "title": "Fides local rules file",
  "description": "data/rules.json. Rules are always real: every record needs at least one source with a URL and retrieval date.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "required": ["title", "url", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "retrieved": { "$ref": "#/$defs/date" },
        "note": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "jurisdiction", "state", "level", "title", "citation", "adopted", "effective", "summary", "provisions", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "state": { "enum": ["AZ", "CA", "CO", "NM", "NV", "UT", "WY"] },
        "level": { "enum": ["city", "town", "county", "state"] },
        "title": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "adopted": { "type": ["string", "null"], "description": "Adoption date as stated by the source; YYYY-MM-DD, or YYYY-MM when the source gives only a month." },
        "effective": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 },
        "provisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["topic", "text"],
            "additionalProperties": false,
            "properties": {
              "topic": { "enum": ["water", "power", "noise", "zoning", "notice", "reporting", "enforcement", "other"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "caveats": { "type": "string", "description": "What we could not confirm, or limits readers should know." },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}
